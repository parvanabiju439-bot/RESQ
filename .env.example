# RESQ server
RESQ_HOST=127.0.0.1
RESQ_PORT=5000

# Demo behavior
DEMO_LOCATION_LAT=11.2588
DEMO_LOCATION_LON=75.7804
DEMO_MAX_RADIUS_KM=5
DEFAULT_HELP_RADIUS_KM=0.8

# Optional live routing through OSRM
ENABLE_LIVE_ROUTING=false
OSRM_BASE_URL=https://router.project-osrm.org

# Optional real phone call after every SOS.
# Use E.164 format, e.g. +919876543210.
# Twilio requires the FROM number to be a Twilio number or a verified outgoing caller ID.
CALL_ON_SOS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CONTROL_STATION_NAME=RESQ Control Station

# Optional: make the call message repeat/longer. false keeps the demo call short.
CONTROL_CALL_REPEAT=false
